{
  "compilerOptions": {
    "strict": true
  },
  "tasks": {
    "check": "deno check extensions/models/kiro/kiro.ts extensions/models/claude/claude.ts",
    "lint": "deno lint extensions/",
    "fmt": "deno fmt extensions/",
    "fmt:check": "deno fmt --check extensions/",
    "test": "deno test --allow-env --allow-read --allow-write --allow-run --allow-sys extensions/"
  },
  "lint": {
    "rules": {
      "exclude": [
        "no-import-prefix"
      ]
    }
  },
  "fmt": {
    "exclude": [
      "extensions/models/kiro/testdata/",
      "extensions/models/claude/testdata/"
    ]
  },
  "imports": {
    "@swamp-club/swamp-testing": "jsr:@swamp-club/swamp-testing@0.20261016.58"
  }
}
